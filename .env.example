APP_NAME=Traziva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://traziva.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (Laragon): crear antes la base "traziva" (utf8mb4_unicode_ci)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=traziva
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Contraseña inicial de los usuarios de demostración (php artisan db:seed).
# Si se deja vacía se genera una aleatoria y se muestra en consola.
TRAZIVA_SEED_PASSWORD=

# Códigos de verificación para registrarse como coordinador/a o responsable (compártelos solo con esas personas).
# Si se dejan vacíos, esos roles no aparecen en el formulario de registro.
TRAZIVA_CODIGO_COORDINADOR=
TRAZIVA_CODIGO_RESPONSABLE=

VITE_APP_NAME="${APP_NAME}"
